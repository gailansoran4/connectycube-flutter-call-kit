<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen incoming call.
  Runtime (initUi): shows app logo + caller name + accept/decline.
  Avatar / call-type stay available in XML but are hidden by default in code.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0955FA">

    <ImageView
        android:id="@+id/call_background_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <!-- Top content: logo → (avatar) → name → (call type) -->
    <LinearLayout
        android:id="@+id/call_top_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="72dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/call_logo_img"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="visible"
            tools:ignore="ContentDescription"
            tools:src="@android:drawable/sym_def_app_icon" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar_img"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/circleImageView"
            app:strokeColor="@android:color/white"
            app:strokeWidth="2dp"
            tools:ignore="ContentDescription"
            tools:src="@drawable/photo_placeholder"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/user_name_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#7F000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#FBFBFB"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="User Name" />

        <TextView
            android:id="@+id/call_type_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:shadowColor="#7F000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#FBFBFB"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Incoming Video call"
            tools:visibility="gone" />
    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:id="@+id/call_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.skyfishjy.library.RippleBackground
                android:id="@+id/reject_button_animation"
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:rb_color="#FF5A33"
                app:rb_duration="3000"
                app:rb_radius="24dp"
                app:rb_rippleAmount="4"
                app:rb_scale="2">

                <ImageView
                    android:id="@+id/end_call_btn"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/selector_call_end"
                    android:onClick="onEndCall"
                    android:padding="18dp"
                    android:src="@drawable/ic_call_end"
                    tools:ignore="ContentDescription" />
            </com.skyfishjy.library.RippleBackground>

            <TextView
                android:id="@+id/reject_button_label_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:shadowColor="#7F000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FBFBFB"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Decline"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.skyfishjy.library.RippleBackground
                android:id="@+id/accept_button_animation"
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:rb_color="#80CB83"
                app:rb_duration="3000"
                app:rb_radius="24dp"
                app:rb_rippleAmount="4"
                app:rb_scale="2">

                <ImageView
                    android:id="@+id/start_call_btn"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/selector_call_start"
                    android:onClick="onStartCall"
                    android:padding="18dp"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/ic_video_call_start" />
            </com.skyfishjy.library.RippleBackground>

            <TextView
                android:id="@+id/accept_button_label_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:shadowColor="#7F000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="#FBFBFB"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Accept"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
